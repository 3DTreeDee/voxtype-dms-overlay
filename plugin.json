{
  "id": "voxtypeOverlay",
  "name": "VoxType Recording Overlay",
  "description": "State-reactive full-screen recording overlay for VoxType: dims every monitor, cuts out the active window with a themed highlight border, and shows a pulsing mic while dictation is live.",
  "category": "utilities",
  "version": "1.1.0",
  "requires_dms": ">=1.5.0",
  "author": "Robert Dannenbring",
  "repo": "https://github.com/rdannenbring/voxtype-dms-overlay",
  "icon": "mic",
  "type": "composite",
  "components": {
    "daemon": "./OverlayDaemon.qml",
    "widget": "./VoxTypeWidget.qml"
  },
  "settings": "./Settings.qml",
  "capabilities": [
    "daemon",
    "dankbar-widget",
    "control-center",
    "ipc"
  ],
  "compositors": [
    "hyprland"
  ],
  "distro": [
    "any"
  ],
  "dependencies": [
    "dms",
    "voxtype",
    "hyprland"
  ],
  "permissions": [
    "process",
    "settings_read",
    "settings_write"
  ]
}
